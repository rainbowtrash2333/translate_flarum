# =============================================================================
# Flarum Translate Backend — Configuration
# =============================================================================
# Copy this file to config.yaml and fill in your values.
# config.yaml is gitignored and should never be committed.
# =============================================================================

server:
  host: "127.0.0.1"
  port: 8000

database:
  driver: "mysql+aiomysql"
  host: "127.0.0.1"
  port: 3306
  user: "flarum_translate"
  password: "your-db-password-here"
  database: "flarum_translate"
  pool_size: 5

providers:
  primary:
    name: "primary"
    base_url: "https://api.openai.com/v1"
    api_key: "${OPENAI_API_KEY}"
    model: "gpt-4o-mini"
    timeout_seconds: 30
    max_retries: 1
  fallback:
    name: "fallback"
    base_url: "https://api.deepseek.com/v1"
    api_key: "${DEEPSEEK_API_KEY}"
    model: "deepseek-chat"
    timeout_seconds: 30
    max_retries: 1

translation:
  max_batch_size: 30
  batch_window_seconds: 1.0
  max_segment_chars: 4000
  lang_map:
    zh: "Simplified Chinese"
    ja: "Japanese"
    en: "English"
    ko: "Korean"
    fr: "French"
    de: "German"
    es: "Spanish"
    ru: "Russian"
    pt: "Portuguese"
    th: "Thai"
    vi: "Vietnamese"
    ar: "Arabic"
