{
    "name": "twikura/flarum-ext-translate",
    "description": "Local translation proxy and forum UI for Flarum.",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Twikura\\Translate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Twikura\\Translate\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "test:all": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "flarum-extension": {
            "title": "Translate",
            "category": "feature",
            "icon": {
                "name": "fas fa-language",
                "backgroundColor": "#2563eb",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
